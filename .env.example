# ---------- Server (never ship these in the app bundle) ----------
# 32+ random characters. Required in production: openssl rand -base64 48
JWT_SECRET=
PORT=8787
# Local file by default. For production use Turso/libSQL: libsql://<db>.turso.io
DATABASE_URL=file:./data/daily-grace.db
DATABASE_AUTH_TOKEN=
# Comma-separated origins allowed to call the API from a browser (Expo web).
CORS_ORIGINS=http://localhost:8081

# Claude API key for devotionals and prayer suggestions (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: API.Bible for a licensed translation. Without these, the public-domain
# World English Bible from bible-api.com is used.
BIBLE_API_KEY=
BIBLE_API_BIBLE_ID=

# RevenueCat: the Authorization header value you set on the webhook in the dashboard,
# and a secret (sk_...) API key so the server can verify entitlements itself.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

# ---------- App (EXPO_PUBLIC_* values are bundled into the app; public keys only) ----------
# Deployed API URL. Leave empty in development to use your computer's LAN address.
EXPO_PUBLIC_API_URL=
# RevenueCat *public* SDK keys (appl_... / goog_...)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SUPPORT_EMAIL=
